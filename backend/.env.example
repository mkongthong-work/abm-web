# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงจาก Supabase (ดูวิธีได้ใน SUPABASE_SETUP.md)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# พอร์ตที่ backend รัน (ไม่ต้องตั้งก็ได้ ค่าเริ่มต้น 3000 — Render จะกำหนดให้อัตโนมัติตอน deploy)
# PORT=3000

# path ของ python3 ที่ติดตั้ง weasyprint ไว้ (ถ้าใช้ venv ที่ pdf-service/venv โค้ดจะหาให้อัตโนมัติ ไม่ต้องตั้งค่านี้)
# ABM_PYTHON_BIN=/path/to/venv/bin/python3

# รหัส PIN สำหรับกันคนนอกเข้าแอป (ด่านชั่วคราวก่อนทำระบบล็อกอินจริง) — ตั้งค่านี้ก่อนขึ้น Render เสมอ
# ถ้าไม่ตั้งค่านี้เลย แอปจะไม่มีการล็อกอินใด ๆ (สะดวกตอน dev ในเครื่อง แต่ห้ามปล่อยว่างตอน deploy จริง)
# ถ้าสงสัยว่า PIN รั่ว แค่เปลี่ยนค่านี้ใน Render แล้ว deploy ใหม่ — ทุกเครื่องที่เคยล็อกอินไว้จะต้องกรอก PIN ใหม่ทันที
# ABM_ACCESS_PIN=248103

# ---- ข้อมูลสำรองอัตโนมัติทางอีเมล (backup) ----
# ใช้ส่งอีเมลข้อมูลสำรองทั้งระบบ ผ่าน Gmail SMTP — ต้องสร้าง "App Password" จากบัญชี Gmail (ไม่ใช่รหัสผ่านล็อกอินปกติ)
# วิธีสร้าง: เปิดการยืนยัน 2 ขั้นตอนของบัญชี Gmail ก่อน แล้วไปที่ myaccount.google.com/apppasswords
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx

# อีเมลปลายทางที่จะรับไฟล์ข้อมูลสำรอง (ถ้าไม่ตั้งค่านี้ จะส่งกลับไปหา SMTP_USER เอง)
# BACKUP_EMAIL_TO=owner@example.com

# รหัสลับสำหรับให้ cron ภายนอก (เช่น cron-job.org) เรียก GET /api/backup/run?secret=... เพื่อสั่งส่งอีเมลข้อมูลสำรอง
# ตั้งเป็นค่าสุ่มที่คาดเดายาก แล้วนำ URL พร้อม secret นี้ไปตั้งเป็น cron job ภายนอก (เช่น ทุกสัปดาห์)
# BACKUP_TRIGGER_SECRET=change-this-to-a-random-secret
